# Application Settings
PROJECT_NAME="Sports Court Booking API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=sports_court_booking

# Optional full database URL (nếu có sẽ ưu tiên sử dụng)
CUSTOM_DATABASE_URL=mysql+pymysql://root:secret@127.0.0.1:3306/sports_court_booking?charset=utf8mb4

# Security & Authentication Configuration
# Khóa bí mật ký JWT HS256 (dùng placeholder mẫu, không dùng giá trị thực tế của prod)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# Thư mục bản build frontend (chỉ đặt khi deploy, để trống ở máy cá nhân)
# FRONTEND_DIST=/home/container/frontend/dist
